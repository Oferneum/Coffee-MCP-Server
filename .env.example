# Copy to .env and fill in real values:  cp .env.example .env
# (.env is gitignored — never commit real secrets.)

# ── Supabase (pgvector knowledge graph + shots/beans tables) ─────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# ── OpenAI (embeddings + LLM extraction) ─────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Admin gate for research_and_ingest_topic (ADMIN-ONLY tool) ───────────────
# Both MUST be set or the tool fails closed (denies everyone). The server is
# identity-blind: authorization comes from headers the DIALED frontend attaches
# to its MCP transport requests AFTER it authenticates the user with Supabase —
# never from an LLM argument.
#
#   The frontend must send, only for the authenticated admin's MCP session:
#     x-user-email:      <the Supabase-verified user email>
#     x-research-secret: <the same value as RESEARCH_INGEST_SECRET below>
#
# The tool constant-time-compares those headers against the two vars below.

# The single email allowed to run research_and_ingest_topic.
ADMIN_EMAIL=ofer.neumann123@gmail.com

# Shared secret proving the request came from the trusted frontend (not the LLM).
# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCH_INGEST_SECRET=replace-with-a-long-random-secret
